{
  "model": "fable",
  "effortLevel": "medium",
  "env": {
    "FLIGHTDECK_ROLE": "pilot",
    "FLIGHTDECK_COCKPIT": "flightdeck/.cockpit",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "crossSessionInbound": "accept",
  "isolatePeerMachines": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/flightdeck/.cockpit/base/bin/session-start.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/flightdeck/.cockpit/base/bin/cockpit-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
