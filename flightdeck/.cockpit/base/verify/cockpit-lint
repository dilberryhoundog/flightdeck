#!/usr/bin/env node
// base/verify/cockpit-lint — the cockpit's paperwork check: every document has a defined shape, and this says whether a file has it.
// Usage: base/verify/cockpit-lint <file>... — exit 0 clean, 2 when a document carries a fault, 1 on a usage or environment error, which are flightcrew's codes.
//
// A markdown file is read for its frontmatter, a JSON file is parsed whole. The schema is chosen by the document's own
// `type` (markdown) or `kind` (JSON), never by where the file sits, so moving a room costs the schemas nothing. Every
// schema in base/verify/schema/ names the values it answers to in its `x-select` list; adding a document type is one
// schema file and nothing else. Two further checks run on the file's name: a MANIFEST-<collection>.json holds `kind`
// equal to <collection>, and a file named for an identifier carries that identifier as its `unit` or `id`.
//
// The output is what the commander ordered of it: one short line when every file is clean, and on a fault one line per
// fault naming the file, the field, what is wrong and the form expected, so the fix is a small edit and needs no second
// tool call. Nothing is written or changed; the linter only reads.
//
// The schema engine and the writers are flightcrew's, copied into lib/ with their origin stated in their headers.

import fs from 'node:fs';
import path from 'node:path';
import process from 'node:process';
import { fileURLToPath } from 'node:url';
import { EXIT, fail, print } from './lib/output.mjs';
import { validate } from './lib/schema-lib.mjs';

const HERE = path.dirname(fileURLToPath(import.meta.url));
const SCHEMA_DIR = path.join(HERE, 'schema');
const CONFIG = path.join(HERE, 'lint.yaml');
const ROOT = path.resolve(HERE, '..', '..');
const USAGE = 'usage: base/verify/cockpit-lint [<file>...]  (.md files are checked on their frontmatter, .json files whole; with no file, everything lint.yaml names)';

/** An identifier at the head of a file name: Ds006.md, Rq013.md, T010.json, M001-cockpit-setup.md, P001-forming-a-team.md. */
const NAMED_ID = /^([A-Z][A-Za-z]{0,2}[0-9]{3})(?:[-.])/;

/** A frontmatter key: lowercase words joined by underscores, which is every key the cockpit uses. */
const KEY = /^([a-z][a-z0-9_]*):(.*)$/;

// ---------------------------------------------------------------------------
// The strict frontmatter reader
// ---------------------------------------------------------------------------

/** The accepted value forms, quoted back at the writer whenever a line is refused. */
const VALUE_FORMS = 'a bare value (work: M001), a quoted string (type: "Dossier") or a bracketed list (generates: ["Rq004", "Rq005"])';

/** Splits a markdown file into its frontmatter block and the body. Returns null when the file opens without one. */
function splitFrontmatter(text) {
  const lines = text.split('\n');
  if (lines[0] !== '---') return null;
  const end = lines.indexOf('---', 1);
  if (end === -1) return null;
  return { lines: lines.slice(1, end), firstLine: 2 };
}

/** One scalar: a quoted string or a bare value. Returns { value } or { error }. */
function readScalar(raw) {
  const text = raw.trim();
  if (text === '') return { error: 'has no value' };
  const quote = text[0];
  if (quote === '"' || quote === "'") {
    if (text.length < 2 || text[text.length - 1] !== quote) return { error: `opens with ${quote} and does not close it` };
    const inner = text.slice(1, -1);
    if (inner.includes(quote)) return { error: `holds a ${quote} inside a ${quote} string` };
    return { value: inner };
  }
  if (text.includes('"') || text.includes("'")) return { error: 'mixes quoted and bare text' };
  if (text.includes(',')) return { error: 'is a comma list, which is not a list here' };
  if (text.includes('[') || text.includes(']')) return { error: 'holds a bracket in a bare value' };
  // A bare true, false or number is that value, as it would be in JSON; quote it to mean the word or the digits.
  if (text === 'true') return { value: true };
  if (text === 'false') return { value: false };
  if (/^-?[0-9]+(\.[0-9]+)?$/.test(text)) return { value: Number(text) };
  return { value: text };
}

/** Splits the inside of a bracketed list on its commas, leaving commas inside quotes alone. */
function splitItems(inner) {
  const items = [];
  let current = '';
  let quote = null;
  for (const character of inner) {
    if (quote) {
      if (character === quote) quote = null;
      current += character;
    } else if (character === '"' || character === "'") {
      quote = character;
      current += character;
    } else if (character === ',') {
      items.push(current);
      current = '';
    } else {
      current += character;
    }
  }
  items.push(current);
  return items;
}

/** One frontmatter value: a bare scalar, a quoted string, or a bracketed list of those. Returns { value } or { error }. */
function readValue(raw, key) {
  const text = raw.trim();
  if (text.startsWith('[')) {
    if (!text.endsWith(']')) return { error: 'opens a list with [ and does not close it with ]' };
    const inner = text.slice(1, -1).trim();
    if (inner === '') return { value: [] };
    const values = [];
    for (const item of splitItems(inner)) {
      const read = readScalar(item);
      if (read.error) return { error: `holds a list item that ${read.error}` };
      values.push(read.value);
    }
    return { value: values };
  }
  // A comma list without brackets is the commonest fault in the cockpit's older frontmatter, so it is named as
  // itself, and the example shows the writer's own field and own items with the brackets put round them.
  if (splitItems(text).length > 1) {
    const shown = text.length > 90 ? `${text.slice(0, 90)}…` : text;
    return { error: 'is a comma list', expected: `brackets around the items, as ${key}: [${shown}]` };
  }
  return readScalar(text);
}

/**
 * Reads a flat frontmatter block. Returns { doc, faults, lineOf, endLine }: one fault per line that is not a key
 * with an accepted value, and a map from key to the line it sits on, so every fault can name a line to open at.
 */
function readFrontmatter(block) {
  const doc = {};
  const faults = [];
  const lineOf = new Map();
  block.lines.forEach((line, index) => {
    const at = block.firstLine + index;
    if (line.trim() === '' || line.trimStart().startsWith('#')) return;
    const match = KEY.exec(line);
    if (!match) {
      faults.push({ line: at, field: 'the line', problem: 'is not a `key: value` line', expected: `one field per line, its value ${VALUE_FORMS}` });
      return;
    }
    const [, key, raw] = match;
    if (key in doc) {
      faults.push({ line: at, field: key, problem: 'is given twice', expected: 'one line per field' });
      return;
    }
    lineOf.set(key, at);
    const read = readValue(raw, key);
    if (read.error) {
      faults.push({ line: at, field: key, problem: read.error, expected: read.expected ?? `a value to be ${VALUE_FORMS}` });
      return;
    }
    doc[key] = read.value;
  });
  return { doc, faults, lineOf, endLine: block.firstLine + block.lines.length };
}

// ---------------------------------------------------------------------------
// The schema store
// ---------------------------------------------------------------------------

/** Every schema in base/verify/schema/, mapped from each value of its `x-select` list to the schema itself. */
function loadSchemas() {
  let names;
  try {
    names = fs.readdirSync(SCHEMA_DIR).filter((name) => name.endsWith('.json')).sort();
  } catch (error) {
    throw new Error(`the schema directory ${SCHEMA_DIR} could not be read: ${error.message}`);
  }
  if (names.length === 0) throw new Error(`the schema directory ${SCHEMA_DIR} holds no schemas`);
  const bySelector = new Map();
  const byFilename = [];
  for (const name of names) {
    const file = path.join(SCHEMA_DIR, name);
    let schema;
    try {
      schema = JSON.parse(fs.readFileSync(file, 'utf8'));
    } catch (error) {
      throw new Error(`schema ${name} is not valid JSON: ${error.message}`);
    }
    const selectors = schema['x-select'] ?? [];
    const pattern = schema['x-select-filename'];
    if (!Array.isArray(selectors) || (selectors.length === 0 && !pattern)) {
      throw new Error(`schema ${name} has no "x-select" list or "x-select-filename" saying which documents it answers to`);
    }
    // A schema that describes a `type` field describes markdown frontmatter; one that describes `kind` describes a JSON file.
    const markdown = Boolean(schema.properties?.type);
    for (const selector of selectors) {
      const held = bySelector.get(selector);
      if (held) throw new Error(`schemas ${held.name} and ${name} both answer to "${selector}"`);
      bySelector.set(selector, { name, schema, markdown });
    }
    // A schema may also answer to a family of file names, for collections that are alike but each carry their own
    // `kind`: every MANIFEST-<collection>.json is a manifest, so a new collection costs a manifest row, not a schema.
    if (pattern) byFilename.push({ name, schema, markdown, test: new RegExp(pattern) });
  }
  return { bySelector, byFilename };
}

/** The property subschema an error path points at, so its `description` can be quoted back as the expected form. */
function fieldDescription(schema, errorPath) {
  // At the root the schema's own description is the whole document's, too long for a fault line, so a schema that
  // rules the document as a whole says what it wants in one clause under `x-expect`.
  if (errorPath === '$') return typeof schema['x-expect'] === 'string' ? schema['x-expect'] : null;
  const parts = errorPath.split('.').slice(1);
  let node = schema;
  for (const raw of parts) {
    const part = raw.replace(/\[[0-9]+\]$/, '');
    const properties = node?.properties;
    if (!properties || !(part in properties)) return null;
    node = properties[part];
    // An indexed segment steps into the array's item schema, where the row's own fields are described.
    if (raw !== part) node = Array.isArray(node?.items) ? node.items[0] : node?.items;
  }
  return typeof node?.description === 'string' ? node.description : null;
}

// ---------------------------------------------------------------------------
// One file
// ---------------------------------------------------------------------------

/** The faults one file carries. Each is { field, problem, expected }; an empty list means the file is clean. */
function lintFile(file, schemas) {
  let text;
  try {
    text = fs.readFileSync(file, 'utf8');
  } catch (error) {
    return [{ field: 'the file', problem: `could not be read: ${error.message}`, expected: 'a readable .md or .json file' }];
  }
  const base = path.basename(file);
  const extension = path.extname(base);
  let doc;
  const faults = [];
  // Where to open the file at, per field: the line the key sits on, or the closing --- for a key that is not there.
  let lineOf = new Map();
  let endLine = null;

  if (extension === '.md') {
    const block = splitFrontmatter(text);
    if (!block) {
      return [{ line: 1, field: 'frontmatter', problem: 'is missing', expected: 'a --- block at the very top of the file, holding at least `type`, closed by a second ---' }];
    }
    const read = readFrontmatter(block);
    faults.push(...read.faults);
    doc = read.doc;
    lineOf = read.lineOf;
    endLine = read.endLine;
  } else if (extension === '.json') {
    try {
      doc = JSON.parse(text);
    } catch (error) {
      return [{ field: 'the file', problem: `is not valid JSON: ${error.message}`, expected: 'a JSON document' }];
    }
  } else {
    return [{ field: 'the file', problem: `has the extension ${extension || '(none)'}`, expected: 'a .md or a .json file' }];
  }

  const markdown = extension === '.md';
  /** The line a fault on this key should send the reader to; only markdown carries lines. */
  const at = (key) => (markdown ? (lineOf.get(key) ?? endLine) : undefined);

  // The name check. A MANIFEST-<collection>.json holds that collection, so its `kind` is that word. It is not
  // generalised to every upper-case prefix: a REGISTER- file is named for what it lists and typed for what it is,
  // so REGISTER-branches.json carries kind "branch-register", which no rule can derive from the file name.
  const collection = /^MANIFEST-(.+)\.json$/.exec(base);
  if (collection && doc?.kind !== collection[1]) {
    faults.push({ field: 'kind', problem: `is ${JSON.stringify(doc?.kind ?? null)} in a file named ${base}`, expected: `kind: "${collection[1]}", the collection the file name gives` });
  }
  const named = NAMED_ID.exec(base);
  if (named) {
    const carried = markdown ? doc?.unit : (doc?.id ?? doc?.unit);
    const field = markdown ? 'unit' : 'id';
    if (carried !== named[1]) {
      faults.push({ line: at(field), field, problem: `is ${JSON.stringify(carried ?? null)} in a file named ${base}`, expected: `${field}: "${named[1]}", the identifier the file name gives` });
    }
  }

  // The schema check.
  const selector = markdown ? doc?.type : doc?.kind;
  const field = markdown ? 'type' : 'kind';
  const offered = [...schemas.bySelector.entries()].filter(([, held]) => held.markdown === markdown).map(([key]) => key).sort().join(', ');
  const byName = schemas.byFilename.find((held) => held.markdown === markdown && held.test.test(base));
  if (selector === undefined && !byName) {
    faults.push({ line: at(field), field, problem: 'is missing, so no schema can be chosen', expected: `${field} naming the document, one of: ${offered}` });
    return faults;
  }
  const exact = selector === undefined ? undefined : schemas.bySelector.get(selector);
  const chosen = (exact && exact.markdown === markdown) ? exact : byName;
  if (!chosen) {
    faults.push({ line: at(field), field, problem: `is ${JSON.stringify(selector)}, which no schema for a ${extension} file answers to`, expected: `one of: ${offered}` });
    return faults;
  }
  const { ok, errors } = validate(chosen.schema, doc);
  if (!ok) {
    // An anyOf or oneOf failure is followed by every branch's own errors; the branch noise says nothing the
    // field's description does not, so the one line stands for the lot.
    const collapsed = [];
    let swallowing = null;
    for (const error of errors) {
      if (swallowing && error.path.startsWith(swallowing)) continue;
      swallowing = null;
      collapsed.push(error);
      if (error.rule === 'anyOf' || error.rule === 'oneOf') swallowing = error.path;
    }
    for (const error of collapsed) {
      // A missing field is reported as that field, with its own description, not as a fault of the whole document.
      const missing = error.rule === 'required' ? /lacks required (\S+)$/.exec(error.message) : null;
      const where = missing ? `${error.path}.${missing[1]}` : error.path;
      const description = fieldDescription(chosen.schema, where);
      const key = where.replace(/^\$\.?/, '');
      faults.push({
        line: markdown ? (lineOf.get(key.split('.')[0].replace(/\[[0-9]+\]$/, '')) ?? endLine) : undefined,
        field: key || 'the document',
        problem: missing ? 'is missing'
          : (error.rule === 'anyOf' || error.rule === 'oneOf') ? 'matches none of the accepted forms'
          : (error.message.replace(/^\$\.?[A-Za-z0-9_.[\]]*\s*/, '').trim() || error.message),
        expected: description ?? `the shape ${chosen.name} gives`,
        rule: error.rule,
      });
    }
  }
  return faults;
}

// ---------------------------------------------------------------------------
// The whole-cockpit run
// ---------------------------------------------------------------------------

/** One glob as a regular expression: ** crosses directories, * and ? stay inside one segment. */
function globToRegExp(glob) {
  let out = '';
  for (let i = 0; i < glob.length; i += 1) {
    const c = glob[i];
    if (c === '*' && glob[i + 1] === '*') {
      i += 1;
      if (glob[i + 1] === '/') { i += 1; out += '(?:[^/]+/)*'; } else out += '.*';
    } else if (c === '*') out += '[^/]*';
    else if (c === '?') out += '[^/]';
    else out += c.replace(/[.+^${}()|[\]\\]/g, '\\$&');
  }
  return new RegExp(`^${out}$`);
}

/** Every file under root, as paths relative to it. The git directory is never walked. */
function walk(root, base = '', found = []) {
  for (const entry of fs.readdirSync(path.join(root, base), { withFileTypes: true })) {
    if (entry.name === '.git') continue;
    const rel = base ? `${base}/${entry.name}` : entry.name;
    if (entry.isDirectory()) walk(root, rel, found);
    else found.push(rel);
  }
  return found;
}

/**
 * The files a whole-cockpit run covers, from lint.yaml beside this script: every file matching a `paths` glob and
 * no `!` glob, in the order the globs are written. A file no glob names is not linted, which is the commander's
 * rule — no path, skipped.
 */
function filesFromConfig(root) {
  let text;
  try {
    text = fs.readFileSync(CONFIG, 'utf8');
  } catch (error) {
    throw new Error(`${path.basename(CONFIG)} could not be read: ${error.message}`);
  }
  const read = readFrontmatter({ lines: text.split('\n'), firstLine: 1 });
  if (read.faults.length > 0) {
    const first = read.faults[0];
    throw new Error(`${path.basename(CONFIG)} line ${first.line}: ${first.field} ${first.problem}`);
  }
  const globs = read.doc.paths;
  if (!Array.isArray(globs) || globs.length === 0) {
    throw new Error(`${path.basename(CONFIG)} has no "paths" list of globs to lint`);
  }
  const include = [];
  const exclude = [];
  for (const glob of globs) {
    if (String(glob).startsWith('!')) exclude.push(globToRegExp(String(glob).slice(1)));
    else include.push(globToRegExp(String(glob)));
  }
  const all = walk(root).sort();
  return all.filter((rel) => include.some((r) => r.test(rel)) && !exclude.some((r) => r.test(rel)));
}

// ---------------------------------------------------------------------------
// The command
// ---------------------------------------------------------------------------

export function main(argv = []) {
  const named = argv.filter((arg) => !String(arg).startsWith('-'));
  if (argv.includes('--help') || argv.includes('-h')) {
    fail(USAGE);
    return EXIT.usage;
  }
  let schemas;
  let files = named;
  let whole = false;
  try {
    schemas = loadSchemas();
    // No file named is the whole cockpit, which is what lint.yaml describes.
    if (named.length === 0) {
      files = filesFromConfig(ROOT).map((rel) => path.join(ROOT, rel));
      whole = true;
    }
  } catch (error) {
    fail(`cockpit-lint cannot run: ${error.message}`);
    return EXIT.usage;
  }
  let total = 0;
  for (const file of files) {
    const from = whole ? ROOT : process.cwd();
    const inside = path.relative(from, path.resolve(file));
    const shown = inside && !inside.startsWith('..') ? inside : path.resolve(file);
    for (const fault of lintFile(file, schemas)) {
      const rule = fault.rule ? ` — [${fault.rule}]` : '';
      const where = fault.line ? `${shown}:${fault.line}` : shown;
      fail(`error: ${where}: ${fault.field} ${fault.problem}; expected ${fault.expected}${rule}`);
      total += 1;
    }
  }
  if (total > 0) {
    fail(`${total} fault${total === 1 ? '' : 's'} in ${files.length} file${files.length === 1 ? '' : 's'}`);
    return EXIT.blocked;
  }
  print(`ok: ${files.length} file${files.length === 1 ? '' : 's'} clean`);
  return EXIT.ok;
}

if (process.argv[1] && fileURLToPath(import.meta.url) === path.resolve(process.argv[1])) {
  process.exit(main(process.argv.slice(2)));
}
