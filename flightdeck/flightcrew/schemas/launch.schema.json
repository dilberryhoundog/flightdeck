{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flightcrew/schemas/launch.schema.json",
  "title": "Launch",
  "description": "launch/<L>/launch.json: the state of one orchestrated run. Exactly one launch folder may carry status active; FLIGHTCREW_LAUNCH overrides that resolution. Rules this schema cannot express, checked by validate-launch.mjs: the spec path resolves to a file; spec.commit equals the pinned spec file's own commit header; a phase past targets with enforce_boundary true carries a lock_commit and non-empty allowed paths; hashes resolve in the repository (only under --resolve-commits).",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "status",
    "phase",
    "created",
    "spec",
    "tests_map",
    "kickoff",
    "base_commit",
    "lock_commit",
    "branch",
    "previous_launch",
    "allow_draft",
    "paths",
    "acceptance",
    "structural",
    "ceilings",
    "gates",
    "outcome",
    "ended"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1, "description": "Folder name under flightdeck/launch/." },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "accepted", "accepted-with-reservations", "abandoned", "partial"]
    },
    "phase": {
      "type": "string",
      "enum": ["targets", "plan", "contracts", "implement", "verify", "review", "report", "ended"],
      "description": "In that order; fc launch phase accepts only the immediately next one."
    },
    "created": { "$ref": "#/$defs/date" },
    "spec": {
      "type": "object",
      "required": ["name", "version", "commit", "file_commit", "path"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "commit": { "$ref": "#/$defs/hashOrNull", "description": "The spec file's own commit header; null while the spec is draft." },
        "file_commit": { "$ref": "#/$defs/hashOrNull", "description": "git log -1 for the spec file; null when untracked." },
        "path": { "type": "string", "minLength": 1, "description": "Launch-relative path of the pinned copy." }
      }
    },
    "tests_map": {
      "type": ["object", "null"],
      "required": ["version", "commit", "path"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "commit": { "$ref": "#/$defs/hashOrNull" },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "kickoff": {
      "type": "object",
      "required": ["path", "version"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1, "description": "The '+'-joined list of part@version." }
      }
    },
    "base_commit": { "$ref": "#/$defs/hash", "description": "HEAD when the launch was created." },
    "lock_commit": { "$ref": "#/$defs/hashOrNull", "description": "HEAD when the tests map was pinned; the base for boundary, locked and the critic diff." },
    "branch": { "type": "string", "minLength": 1 },
    "previous_launch": { "type": ["string", "null"], "description": "Newest other launch with the same spec name, or null." },
    "allow_draft": { "type": "boolean", "description": "True when a human accepted a draft spec or map with --allow-draft." },
    "paths": {
      "type": "object",
      "required": ["allowed", "locked", "enforce_boundary"],
      "additionalProperties": false,
      "properties": {
        "allowed": { "type": "array", "items": { "$ref": "#/$defs/glob" } },
        "locked": { "type": "array", "items": { "$ref": "#/$defs/glob" } },
        "enforce_boundary": { "type": "boolean" }
      }
    },
    "acceptance": { "type": "string", "minLength": 1, "description": "The acceptance check id, T1." },
    "structural": {
      "type": "object",
      "description": "One shell command per file extension: the key is the extension with its leading dot, the value a command containing the literal {file}.",
      "additionalProperties": { "type": "string", "pattern": "\\{file\\}" }
    },
    "ceilings": {
      "type": "object",
      "required": [
        "agents",
        "implementers_concurrent",
        "turns_per_agent",
        "gate_iterations",
        "stop_blocks",
        "critic_passes",
        "minutes",
        "tokens",
        "expected_tokens"
      ],
      "additionalProperties": false,
      "properties": {
        "agents": { "type": "integer", "minimum": 0 },
        "implementers_concurrent": { "type": "integer", "minimum": 1 },
        "turns_per_agent": { "type": "integer", "minimum": 1 },
        "gate_iterations": { "type": "integer", "minimum": 0 },
        "stop_blocks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8,
          "description": "Claude Code ends the turn after eight consecutive Stop-hook blocks, so the cap is min(stop_blocks, 8)."
        },
        "critic_passes": { "type": "integer", "minimum": 0 },
        "minutes": { "type": "integer", "minimum": 0 },
        "tokens": { "type": ["integer", "null"], "minimum": 0 },
        "expected_tokens": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "gates": {
      "type": "object",
      "required": ["G1", "G2", "G3"],
      "additionalProperties": false,
      "properties": {
        "G1": { "$ref": "#/$defs/gate" },
        "G2": { "$ref": "#/$defs/gate" },
        "G3": { "$ref": "#/$defs/gate" }
      }
    },
    "outcome": {
      "type": ["string", "null"],
      "description": "Set by fc launch end; one of accepted, accepted-with-reservations, abandoned, partial."
    },
    "ended": { "$ref": "#/$defs/isoOrNull" },
    "accepted_units": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "abandoned_units": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "landed": {
      "type": "object",
      "required": ["commit", "pr", "integration_check"],
      "additionalProperties": false,
      "properties": {
        "commit": { "$ref": "#/$defs/hash" },
        "pr": { "type": ["string", "null"] },
        "integration_check": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "hashOrNull": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" },
    "isoOrNull": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}" },
    "glob": { "type": "string", "minLength": 1 },
    "gate": {
      "type": "object",
      "required": ["status", "at"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["pending", "approved", "exited"] },
        "at": { "$ref": "#/$defs/isoOrNull" },
        "note": { "type": "string" }
      }
    }
  }
}
